[core]
	excludesfile = ~/.gitignore_global
	attributesfile = ~/.gitattributes_global
	autocrlf = input
	pager = delta
    editor = nvim

[user]
	name = Serhii Dudar
	email = shtanga.net@gmail.com

[alias]
    st = status -sb
    # lg = log --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr)%Creset' --abbrev-commit --date=relative
    lg = log --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit --decorate --date=short --color --decorate

[interactive]
    diffFilter = delta --color-only

[init]
    defaultBranch = main

[delta]
    navigate = true    # use n and N to move between diff sections
    line-numbers = true
    light = false
    side-by-side = false
    line-numbers = true
    syntax-theme = gruvbox-dark
    file-style = bold yellow ul
    file-decoration-style = none
    hunk-header-style = file line-number syntax
    # delta detects terminal colors automatically; set one of these to disable auto-detection
    # dark = true
    # light = true

# https://github.com/chojs23/ec
# `git mergetool` and lazygit's `M` (conflicts panel) open ec; diffview.nvim is started from nvim (<leader>gm), not as a mergetool
[merge]
    tool = ec # diffview|nvimdiff|vimdiff|ec
    conflictstyle = zdiff3 # like diff3, but lines common to both sides are moved out of the conflict block

# https://codeberg.org/mergiraf/mergiraf - syntax-aware (tree-sitter) merge driver: resolves import / adjacent-method
# conflicts git's line-based merge can't, falls back to the normal line-based merge + markers when it can't.
# Enabled per path in ~/.gitattributes_global (`* merge=mergiraf`); `mergiraf solve <file>` retries an
# already-conflicted file, `mergiraf languages` lists supported languages. Plays with rerere.
[merge "mergiraf"]
    name = mergiraf
    driver = mergiraf merge --git %O %A %B -s %S -x %X -y %Y -p %P -l %L

[mergetool]
	keepBackup = false
	prompt = false

[mergetool "ec"]
    # cmd = ec \"$BASE\" \"$LOCAL\" \"$REMOTE\" \"$MERGED\"
    # `e` in ec opens the file in nvim with diffview's merge view (scripts/git/ec-editor.sh), not plain $EDITOR
    cmd = EDITOR=$HOME/dotfiles/scripts/git/ec-editor.sh ec "$BASE" "$LOCAL" "$REMOTE" "$MERGED"
    trustExitCode = true

; [mergetool "diffview"]
;     cmd = nvim -n -c "DiffviewOpen" "$MERGE"
;     trustExitCode = true

# need have configured [https://github.com/akinsho/git-conflict.nvim] or similar solution to works with conflicts, I prefer diffview
; [mergetool "nvimdiff"]
;     cmd = nvim -d $LOCAL $REMOTE $MERGED -c '$wincmd w' -c 'wincmd J'
;     trustExitCode = true

[diff]
    algorithm = histogram
    colorMoved = default
    tool = nvimdiff # ec is a merge tool only (no difftool.ec.cmd); nvimdiff is built into git

[pull]
    # rebase = false
    rebase = true
    default = current

[rebase]
    autoStash = true
    missingCommitsCheck = warn  # warn if rebasing with missing commits

[push]
    autoSetupRemote = true  # easier to push new branches
    default = current  # push only current branch by default
    # followTags = true  # push also tags

[rerere]
    enabled = true