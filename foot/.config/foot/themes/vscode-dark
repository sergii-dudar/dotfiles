# -*- conf -*-
# VS Code Dark+ (the vscode integrated-terminal palette): the same 16 colours and foreground as alacritty
# themes/vscode.toml (alacritty-theme repo), ghostty theme "Dark+" and wezterm color_scheme "Dark+".
# Themes ship background=1e1e1e; alacritty.toml overrides it (was 181818) and ghostty/wezterm follow, so here too.
# cursor= and selection-* are set in foot.ini [colors-dark] (same in all terminals), not here.

[colors-dark]
foreground=cccccc
background=121212
regular0=000000  # black
regular1=cd3131  # red
regular2=0dbc79  # green
regular3=e5e510  # yellow
regular4=2472c8  # blue
regular5=bc3fbc  # magenta
regular6=11a8cd  # cyan
regular7=e5e5e5  # white

bright0=666666   # bright black
bright1=f14c4c   # bright red
bright2=23d18b   # bright green
bright3=f5f543   # bright yellow
bright4=3b8eea   # bright blue
bright5=d670d6   # bright magenta
bright6=29b8db   # bright cyan
bright7=e5e5e5   # bright white